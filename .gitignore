__pycache__/
*.py[cod]

# The one-click installer builds its venv here, plus scratch space for uploads
# and transcoded previews. Neither belongs in the repository.
.venv/
venv/
cache/

# Credentials, settings, IP history and the commit journal. Never committed.
data/
logs/

# A locally-dropped ffmpeg binary is picked up automatically; don't commit it.
ffmpeg/
ffmpeg.exe

# Scratch media used while testing.
samples/
